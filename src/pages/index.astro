---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import Imagen from '../components/Imagen.astro';
import ProductoCard from '../components/ProductoCard.astro';
import {GaleriaHorizontal} from '../components/ui/galeria-horizontal';
import {TextoRevela} from '../components/ui/texto-revela';
import servicios from '../data/servicios.json';
import proyectos from '../data/proyectos.json';
import {publicados, porSlug} from '../lib/catalogo';
import imagenes from '../data/imagenes.json';
import firma from '../../public/img/marca/firma-pz.svg?raw';
import {negocio} from '../lib/negocio';
import {tienda} from '../lib/tienda';
import {cinta,altoLogo,logoDe,logoProyecto} from '../lib/clientes';
const P=(slug:string)=>proyectos.find(p=>p.slug===slug)!;
const dim=(src:string)=>imagenes[src as keyof typeof imagenes];
const alt=(p:ReturnType<typeof P>)=>`${p.nombre} de ${p.cliente}, proyecto de ${p.tipo.toLowerCase()} realizado por PZ Design`;
// Galería inclinada del héroe (maqueta del manual v2): 4 columnas de 5 fotos limpias del book, sin rótulos ni logos de clientes.
// Cada columna repite su juego completo una vez y el bucle avanza exactamente un juego, así el salto no se ve.
const columnas=[
  ['kupfer-2/03','pesco-edificio-comercial/13','chile-food-oficinas/03','pesco-edificio-comercial/11','universidad-de-chile/01'],
  ['la-folie/02','sadia-brf/03','kupfer-1/02','pesco-casino/03','radio-40-principales/02'],
  ['pesco-edificio-comercial/09','kupfer-2/07','la-folie/04','pesco-edificio-comercial/03','sadia-brf/01'],
  ['kupfer-2/01','pesco-casino/01','monsanto-viluco/02','pesco-rrhh/02','pesco-edificio-comercial/01'],
].map(c=>c.map(r=>{const p=P(r.split('/')[0]);const src=`/img/proyectos/mini/${r}.jpg`;return {src,cliente:p.cliente,...dim(src)};}));
// Tarjeta de la tienda: un abanico de productos confirmados del catálogo (sin butacas ni cabinas), cada uno con su lugar y escala.
const mosaicoSlugs:[string,string][]=[['ergohuman','m-a'],['big-boss-negra','m-b'],['gold-up','m-c'],['logan-malla','m-d'],['max-plus','m-e'],['tossy-blanca','m-f']];
const mosaico=mosaicoSlugs.map(([slug,pos])=>{const p=porSlug(slug);return p&&publicados.includes(p)?{pos,modelo:p.modelo,src:p.imagen.replace('/catalogo/','/catalogo/mini/'),...dim(p.imagen.replace('/catalogo/','/catalogo/mini/'))}:null;}).filter((x):x is NonNullable<typeof x>=>!!x);
const titular=['Espacios','de','trabajo','diseñados','a','la','medida'];
const acento=new Set(['diseñados','medida']);
const fotoServicio:Record<string,string>={'habilitacion-de-oficinas':'pesco-edificio-comercial/06','diseno-y-arquitectura-interior':'kupfer-2/01','proyectos-especiales':'radio-40-principales/01','locales-comerciales':'la-folie/02'};
const tarjetas=servicios.map(s=>{const src=`/img/proyectos/mini/${fotoServicio[s.slug]}.jpg`;return {href:`/${s.slug}/`,titulo:s.titulo,texto:s.intro,src,...dim(src)};});
const galeria=['kupfer-2','pesco-casino','pesco-edificio-comercial','chile-food-oficinas','panini','la-folie','monsanto-viluco','kupfer-1'].map(s=>{const p=P(s);return {href:`/proyectos/${p.slug}/`,src:p.imagen,alt:alt(p),...dim(p.imagen),cliente:p.cliente,nombre:p.nombre,tipo:p.tipo,m2:p.m2,logo:logoProyecto[p.slug]&&logoDe(logoProyecto[p.slug])?{slug:logoDe(logoProyecto[p.slug])!.slug,ratio:logoDe(logoProyecto[p.slug])!.ratio}:null};});
const conM2=proyectos.filter(p=>p.m2);
const totalM2=conM2.reduce((a,p)=>a+Number(p.m2),0);
const manifiesto='Tu empresa cambia. Diseñamos el espacio para lo que viene. Escuchamos lo que necesita tu equipo y lo traducimos en un proyecto integrado, con diseño, presupuesto, obra y equipamiento supervisados por Paola.';
const cifraK=(P('kupfer-2').resultado?.cifra??'').match(/^(\D*)([\d.,]+)(.*)$/);
const flecha='<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>';
---
<Base title="Habilitación de oficinas y diseño interior | PZ Design" description="Diseñamos y habilitamos oficinas, radios y locales comerciales en Santiago. Un proceso integrado, mobiliario a medida y un responsable de principio a fin.">
<section class="v2-heroe">
  <div class="v2-plano" aria-hidden="true"></div>
  <div class="container v2-heroe-in">
    <div class="v2-copia">
      <h1 class="v2-titular">{titular.map((w,i)=><><span class="v2-palabra"><span class:list={[acento.has(w)&&'v2-acento']} style={`--i:${i}`}>{w}</span></span>{' '}</>)}</h1>
      <p class="intro answer-first"><span>Proyecto, mobiliario e instalación con un solo responsable, del primer plano a la entrega llave en mano.</span> <span class="intro-resto" id="intro-resto">Diseñamos y habilitamos oficinas, radios y locales comerciales en Santiago, e integramos arquitectura interior, obra y mobiliario para que tu espacio responda a lo que necesita tu equipo, con una propuesta acordada contigo.</span></p><button type="button" class="intro-mas" aria-expanded="false" aria-controls="intro-resto" data-intro-mas>Leer más</button>
      <div class="actions"><a class="button" href="/contacto/">Agenda una visita <span class="flecha" aria-hidden="true">↗</span></a><a href="/proyectos/">Ver {proyectos.length} proyectos</a></div>
    </div>
    <div class="v2-galeria" aria-hidden="true"><div class="v2-inclina">{columnas.map((c,i)=><div class:list={['v2-col',`v2-col-${i}`]}><div class="v2-pista">{[0,1].map(()=>c.map(f=><figure><img src={f.src} alt={`Proyecto de ${f.cliente} realizado por PZ Design`} width={f.width} height={f.height} loading="lazy" decoding="async"/><figcaption>{f.cliente}</figcaption></figure>))}</div></div>)}</div></div>
  </div>
</section>

<section class="v2-clientes"><h2 class="solo-lectores sr-only">Clientes de nuestro book</h2><div class="v2-cinta" aria-hidden="true"><div class="v2-cinta-pista">{[0,1].map(()=>cinta.map(c=><><span class:list={['v2-cliente',c.logo?'v2-logo':'v2-nombre']} style={c.logo?`--u:url(/img/clientes/${c.logo.slug}.png);--r:${c.logo.ratio};--h:${altoLogo(c.logo.ratio)}px`:undefined}>{c.logo?'':c.nombre}</span><i>✕</i></>))}</div></div><ul class="solo-lectores sr-only">{negocio.clientes.map(c=><li>{c}</li>)}</ul></section>

<section class="v2-servicios"><div class="container"><div class="section-heading" data-revela><h2>Lo que hacemos, de principio a fin</h2><a href="/como-trabajamos/">Conoce nuestro proceso <span class="flecha" aria-hidden="true">↗</span></a></div>
<div class="v2-tarjetas">{tarjetas.map(t=><a class="v2-tarjeta" href={t.href} data-servicio><img src={t.src} alt={`${t.titulo}, proyecto realizado por PZ Design`} width={t.width} height={t.height} loading="lazy" decoding="async" style={`max-width:${t.width}px`}/><span class="v2-tarjeta-texto"><span class="v2-tarjeta-titulo">{t.titulo}</span><span class="v2-tarjeta-detalle">{t.texto}</span></span><span class="v2-tarjeta-ir" aria-hidden="true" set:html={flecha}/></a>)}</div></div></section>

<section class="container section"><h2 class="solo-lectores sr-only">Dos maneras de trabajar con PZ Design</h2><div class="dos-caras" data-revela><a class="cara" href="/habilitacion-de-oficinas/"><Imagen src={P('kupfer-2').imagen.replace('/proyectos/','/proyectos/mini/')} alt={alt(P('kupfer-2'))} posicion={P('kupfer-2').posicionImagen}/><span class="velo" aria-hidden="true"></span><span><span class="cara-nombre">Proyectos para empresas</span><span class="cara-texto">Habilitamos oficinas, radios y locales: diseño, obra y mobiliario con un solo responsable.</span><span class="cara-ir">Ver servicios <span class="flecha" aria-hidden="true">↗</span></span></span><span class="ir-redondo" aria-hidden="true">↗</span></a><a class="cara producto" href="/mobiliario-de-oficina/"><span class="mosaico">{mosaico.map((m,i)=><span class={`mos-item ${m.pos}`} style={`--d:${i}`}><img src={m.src} alt={`${m.modelo}, mobiliario del catálogo de PZ Design`} width={m.width} height={m.height} loading="lazy" decoding="async"/></span>)}</span><span><span class="cara-nombre">{tienda?'Tienda de mobiliario':'Mobiliario de oficina'}</span><span class="cara-texto">{tienda?'Sillas y escritorios para tu oficina: compra en línea o pide una cotización por volumen para tu empresa.':'Sillas y escritorios para tu oficina, con asesoría y cotización según la cantidad que necesitas.'}</span><span class="cara-ir">{tienda?'Ir a la tienda':'Ver el catálogo'} <span class="flecha" aria-hidden="true">↗</span></span></span><span class="ir-redondo" aria-hidden="true">↗</span></a></div></section>

<section class="container manifiesto"><TextoRevela client:visible texto={manifiesto}/><a class="manifiesto-enlace" href="/paola-zaid/">Conoce a Paola Zaid <span class="flecha" aria-hidden="true">↗</span></a></section>

<section class="banda-noche"><GaleriaHorizontal client:visible items={galeria}><div class="container section-heading galeria-cabeza"><h2>Espacios con identidad</h2><a href="/proyectos/">Ver los {proyectos.length} proyectos <span class="flecha" aria-hidden="true">↗</span></a></div></GaleriaHorizontal></section>

<section class="container section cifras"><h2 class="solo-lectores sr-only">PZ Design en cifras</h2><div class="bento" data-revela><div class="b-grande"><span class="b-rotulo">Superficie del book</span><strong data-cuenta={totalM2} data-sufijo=" m²">{totalM2.toLocaleString('es-CL')} m²</strong><span>intervenidos en {conM2.length} proyectos del book con superficie documentada</span><svg class="b-cota" viewBox="0 0 100 16" preserveAspectRatio="none" aria-hidden="true"><line x1="0" y1="2" x2="0" y2="14"/><line x1="0" y1="8" x2="100" y2="8"/><line x1="100" y1="2" x2="100" y2="14"/></svg></div><div class="b-roble"><span class="b-rotulo">Küpfer</span><strong data-cuenta={cifraK?.[2]} data-prefijo={cifraK?.[1]} data-sufijo={cifraK?.[3]}>{P('kupfer-2').resultado?.cifra}</strong><span>de dotación en el área intervenida</span></div><div class="b-papel"><span class="b-rotulo">Book 2024</span><strong data-cuenta={proyectos.length}>{proyectos.length}</strong><span>proyectos de oficinas, radios y locales</span></div><div class="b-linea"><span class="b-rotulo">Desde {negocio.fundacion}</span><span>PZ Design es la marca de la diseñadora industrial Paola Zaid</span></div></div><p class="small muted">Fuente: book PZ Design 2024 (v2). Superficies en las páginas 4, 8, 10, 11, 12 y 18; dotación de Küpfer en la página 11. El total suma los 6 proyectos con superficie publicada.</p></section>

<section class="container section paola"><div class="paola-firma" aria-hidden="true" data-revela><span set:html={firma}/></div><div data-revela><p class="eyebrow">Diseño y ejecución</p><h2>Lo que acordamos guía lo que entregamos</h2><p>Escuchamos lo que necesita tu empresa y lo traducimos en un proyecto integrado. Coordinamos diseño, presupuesto, obra y equipamiento con equipo propio y contratistas supervisados por Paola.</p><p>Buscamos que cada decisión se refleje en una solución útil, con muebles de calidad y atención durante el proceso.</p><div class="actions"><a href="/paola-zaid/">Conoce a Paola Zaid</a></div></div></section>

<section class="banda-arena"><div class="container section"><div class="section-heading" data-revela><h2>Mobiliario para tu forma de trabajar</h2><a href="/mobiliario-de-oficina/">Explora el catálogo <span class="flecha" aria-hidden="true">↗</span></a></div><p class="text-column muted">Te ayudamos a elegir según el espacio y la cantidad que necesitas. Entregamos las sillas armadas en 3 a 7 días hábiles; el mobiliario tiene un plazo de 7 a 20 días hábiles, sujeto a la confirmación de tu cotización.</p><div class="grid" data-revela>{['tossy-negra','ergohuman','gold-up'].map(slug=>porSlug(slug)).filter(p=>p&&publicados.includes(p)).map(p=><ProductoCard producto={p}/>)}</div></div></section>
<CTA/>
</Base>
<script>
// «Leer más» del héroe: el párrafo completo está siempre en el HTML; aquí solo se abre a la vista.
const mas=document.querySelector<HTMLButtonElement>('[data-intro-mas]');
mas?.addEventListener('click',()=>{const abierto=mas.getAttribute('aria-expanded')==='true';mas.setAttribute('aria-expanded',String(!abierto));mas.textContent=abierto?'Leer más':'Leer menos';document.getElementById('intro-resto')?.classList.toggle('abierto',!abierto);});
</script>
