---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import Imagen from '../components/Imagen.astro';
import Cota from '../components/Cota.astro';
import ProductoCard from '../components/ProductoCard.astro';
import {ZoomParallax} from '../components/ui/zoom-parallax';
import {GaleriaHorizontal} from '../components/ui/galeria-horizontal';
import {TextoRevela} from '../components/ui/texto-revela';
import {PanelesExpandibles} from '../components/ui/paneles-expandibles';
import servicios from '../data/servicios.json';
import proyectos from '../data/proyectos.json';
import catalogo from '../data/catalogo.json';
import imagenes from '../data/imagenes.json';
import firma from '../../public/img/marca/firma-pz.svg?raw';
import {negocio} from '../lib/negocio';
const P=(slug:string)=>proyectos.find(p=>p.slug===slug)!;
const dim=(src:string)=>imagenes[src as keyof typeof imagenes];
const alt=(p:ReturnType<typeof P>)=>`${p.nombre} de ${p.cliente}, proyecto de ${p.tipo.toLowerCase()} realizado por PZ Design`;
const heroe=P('kupfer-2');
const zoom=['kupfer-1','pesco-edificio-comercial','chile-food-oficinas','sadia-brf','radio-40-principales','panini','rock-and-pop'].map(s=>{const p=P(s);return {src:p.imagen,alt:alt(p),...dim(p.imagen)};});
const fotoServicio:Record<string,string>={'habilitacion-de-oficinas':'pesco-edificio-comercial','diseno-y-arquitectura-interior':'chile-food-oficinas','proyectos-especiales':'rock-and-pop','locales-comerciales':'la-folie'};
const paneles=servicios.map(s=>{const p=P(fotoServicio[s.slug]??'kupfer-1');return {href:`/${s.slug}/`,titulo:s.titulo,texto:s.texto,src:p.imagen,alt:alt(p),...dim(p.imagen)};});
const galeria=['kupfer-1','pesco-casino','chile-food-oficinas','sadia-brf','pesco-edificio-comercial','radio-40-principales','panini','universidad-de-chile'].map(s=>{const p=P(s);return {href:`/proyectos/${p.slug}/`,src:p.imagen,alt:alt(p),...dim(p.imagen),cliente:p.cliente,nombre:p.nombre,tipo:p.tipo,m2:p.m2};});
const conM2=proyectos.filter(p=>p.m2);
const totalM2=conM2.reduce((a,p)=>a+Number(p.m2),0);
const manifiesto='Tu empresa cambia. Diseñamos el espacio para lo que viene. Escuchamos lo que necesita tu equipo y lo traducimos en un proyecto integrado, con diseño, presupuesto, obra y equipamiento supervisados por Paola.';
---
<Base title="Habilitación de oficinas y diseño interior | PZ Design" description="Diseñamos y habilitamos oficinas, radios y locales comerciales en Santiago. Un proceso integrado, mobiliario a medida y un responsable de principio a fin.">
<section class="container heroe"><p class="eyebrow">Arquitectura + diseño de interior · Desde {negocio.fundacion}</p><h1><span class="linea">Espacios que acompañan</span> <span class="linea">a tu empresa</span></h1><p class="intro answer-first">Diseñamos y habilitamos oficinas, radios y locales comerciales en Santiago con soluciones a la medida. Integramos arquitectura interior, obra y mobiliario para que tu espacio responda a las necesidades de tu equipo. Te acompañamos desde el levantamiento hasta la entrega, con un solo responsable y una propuesta acordada contigo.</p><div class="heroe-pie"><div class="actions"><a class="button" href="/contacto/">Conversemos sobre tu proyecto <span class="flecha" aria-hidden="true">↗</span></a><a href="/proyectos/">Conoce nuestro trabajo</a></div><p class="heroe-nota">Tu empresa cambia.<br/>Diseñamos el espacio para lo que viene.</p></div></section>
<figure class="container heroe-foto"><div class="marco" data-cota><Imagen src={heroe.imagen} alt="Puestos de trabajo y paneles separadores en el edificio comercial de Küpfer" posicion={heroe.posicionImagen}/><Cota m2={heroe.m2}/></div><figcaption>Küpfer · Edificio comercial · {heroe.m2} m² intervenidos</figcaption></figure>

<section class="recorre"><div class="container recorre-cabeza" data-revela><p class="eyebrow">Proyectos del book</p><h2>Entra a los espacios que habilitamos</h2></div><ZoomParallax client:visible images={zoom}/></section>

<section class="container manifiesto"><TextoRevela client:visible texto={manifiesto}/><a class="manifiesto-enlace" href="/paola-zaid/">Conoce a Paola Zaid <span class="flecha" aria-hidden="true">↗</span></a></section>

<section class="container section"><div class="section-heading" data-revela><h2>Un proyecto, una mirada integral</h2><a href="/como-trabajamos/">Conoce nuestro proceso <span class="flecha" aria-hidden="true">↗</span></a></div><PanelesExpandibles client:visible paneles={paneles}/></section>

<section class="banda-noche"><div class="container section-heading galeria-cabeza" data-revela><h2>Espacios con identidad</h2><a href="/proyectos/">Ver los 16 proyectos <span class="flecha" aria-hidden="true">↗</span></a></div><GaleriaHorizontal client:visible items={galeria}/></section>

<section class="container section cifras"><div class="cifras-grid" data-revela><div><strong data-cuenta={totalM2}>{totalM2.toLocaleString('es-CL')} m²</strong><span>intervenidos en {conM2.length} proyectos del book con superficie documentada</span></div><div><strong>{P('kupfer-2').resultado?.cifra}</strong><span>de dotación en el área intervenida de Küpfer</span></div><div><strong data-cuenta={proyectos.length}>{proyectos.length}</strong><span>proyectos de oficinas, radios y locales en nuestro book 2024</span></div></div><p class="small muted">Fuente: book PZ Design 2024.</p></section>

<section class="container section paola"><div class="paola-firma" aria-hidden="true" data-revela><span set:html={firma}/></div><div data-revela><p class="eyebrow">Diseño y ejecución</p><h2>Lo que acordamos guía lo que entregamos</h2><p>Escuchamos lo que necesita tu empresa y lo traducimos en un proyecto integrado. Coordinamos diseño, presupuesto, obra y equipamiento con equipo propio y contratistas supervisados por Paola.</p><p>Buscamos que cada decisión se refleje en una solución útil, con muebles de calidad y atención durante el proceso.</p><div class="actions"><a href="/paola-zaid/">Conoce a Paola Zaid</a></div></div></section>

<section class="container section"><div class="section-heading" data-revela><h2>Mobiliario para tu forma de trabajar</h2><a href="/mobiliario-de-oficina/">Explora el catálogo <span class="flecha" aria-hidden="true">↗</span></a></div><p class="text-column muted">Te ayudamos a elegir según el espacio y la cantidad que necesitas. Entregamos las sillas armadas en 3 a 7 días hábiles; el mobiliario tiene un plazo de 7 a 20 días hábiles, sujeto a la confirmación de tu cotización.</p><div class="grid" data-revela>{['tossy-negra','ergohuman','gold-up'].map(slug=><ProductoCard producto={catalogo.find(p=>p.slug===slug)}/>)}</div></section>

<section class="clientes"><div class="container"><p class="eyebrow">Clientes de nuestro book</p><h2>Experiencia en distintos sectores</h2></div><div class="cinta" aria-hidden="true"><div class="cinta-pista">{[0,1].map(()=><span class="cinta-grupo">{negocio.clientes.map(c=><span>{c}</span>)}</span>)}</div></div><ul class="container client-list solo-lectores">{negocio.clientes.map(c=><li>{c}</li>)}</ul></section>
<CTA/>
</Base>
