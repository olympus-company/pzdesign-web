---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import Imagen from '../components/Imagen.astro';
import ProductoCard from '../components/ProductoCard.astro';
import {GaleriaHorizontal} from '../components/ui/galeria-horizontal';
import {TextoRevela} from '../components/ui/texto-revela';
import servicios from '../data/servicios.json';
import proyectos from '../data/proyectos.json';
import {publicados, porSlug} from '../lib/catalogo';
import imagenes from '../data/imagenes.json';
import firma from '../../public/img/marca/firma-pz.svg?raw';
import {negocio, aniosExperiencia} from '../lib/negocio';
import {tienda} from '../lib/tienda';
const P=(slug:string)=>proyectos.find(p=>p.slug===slug)!;
const dim=(src:string)=>imagenes[src as keyof typeof imagenes];
const alt=(p:ReturnType<typeof P>)=>`${p.nombre} de ${p.cliente}, proyecto de ${p.tipo.toLowerCase()} realizado por PZ Design`;
// Galería inclinada del héroe (maqueta del manual v2): 3 columnas de fotos limpias del book, sin rótulos ni logos de clientes.
const columnas=[
  ['kupfer-2/03','pesco-edificio-comercial/13','chile-food-oficinas/03','pesco-edificio-comercial/11'],
  ['la-folie/02','sadia-brf/03','kupfer-1/02','pesco-casino/03'],
  ['pesco-edificio-comercial/09','kupfer-2/07','la-folie/04','pesco-edificio-comercial/03'],
].map(c=>c.map(r=>{const p=P(r.split('/')[0]);const src=`/img/proyectos/${r}.jpg`;return {src,cliente:p.cliente,...dim(src)};}));
const titular=['Espacios','de','trabajo','diseñados','a','la','medida'];
const acento=new Set(['diseñados','medida']);
const fotoServicio:Record<string,string>={'habilitacion-de-oficinas':'pesco-edificio-comercial/06','diseno-y-arquitectura-interior':'kupfer-2/01','proyectos-especiales':'radio-40-principales/01','locales-comerciales':'la-folie/02'};
const tarjetas=servicios.map(s=>{const src=`/img/proyectos/${fotoServicio[s.slug]}.jpg`;return {href:`/${s.slug}/`,titulo:s.titulo,texto:s.intro,src,...dim(src)};});
const galeria=['kupfer-2','pesco-casino','pesco-edificio-comercial','chile-food-oficinas','panini','la-folie','monsanto-viluco','kupfer-1'].map(s=>{const p=P(s);return {href:`/proyectos/${p.slug}/`,src:p.imagen,alt:alt(p),...dim(p.imagen),cliente:p.cliente,nombre:p.nombre,tipo:p.tipo,m2:p.m2};});
const conM2=proyectos.filter(p=>p.m2);
const totalM2=conM2.reduce((a,p)=>a+Number(p.m2),0);
const manifiesto='Tu empresa cambia. Diseñamos el espacio para lo que viene. Escuchamos lo que necesita tu equipo y lo traducimos en un proyecto integrado, con diseño, presupuesto, obra y equipamiento supervisados por Paola.';
const flecha='<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>';
---
<Base title="Habilitación de oficinas y diseño interior | PZ Design" description="Diseñamos y habilitamos oficinas, radios y locales comerciales en Santiago. Un proceso integrado, mobiliario a medida y un responsable de principio a fin.">
<section class="v2-heroe">
  <div class="v2-plano" aria-hidden="true"></div>
  <div class="container v2-heroe-in">
    <div class="v2-copia">
      <h1 class="v2-titular">{titular.map((w,i)=><><span class="v2-palabra"><span class:list={[acento.has(w)&&'v2-acento']} style={`--i:${i}`}>{w}</span></span>{' '}</>)}</h1>
      <p class="intro answer-first">Diseñamos y habilitamos oficinas, radios y locales comerciales en Santiago con soluciones a la medida. Integramos arquitectura interior, obra y mobiliario para que tu espacio responda a las necesidades de tu equipo. Te acompañamos desde el levantamiento hasta la entrega, con un solo responsable y una propuesta acordada contigo.</p>
      <div class="actions"><a class="button" href="/contacto/">Agenda una visita <span class="flecha" aria-hidden="true">↗</span></a><a href="/proyectos/">Ver {proyectos.length} proyectos</a></div>
    </div>
    <div class="v2-galeria" aria-hidden="true"><div class="v2-inclina">{columnas.map((c,i)=><div class:list={['v2-col',`v2-col-${i}`]}><div class="v2-pista">{[0,1].map(()=>c.map(f=><figure><img src={f.src} alt={`Proyecto de ${f.cliente} realizado por PZ Design`} width={f.width} height={f.height} loading="lazy" decoding="async"/><figcaption>{f.cliente}</figcaption></figure>))}</div></div>)}</div></div>
  </div>
</section>

<section class="v2-clientes"><h2 class="solo-lectores sr-only">Clientes de nuestro book</h2><div class="v2-cinta" aria-hidden="true"><div class="v2-cinta-pista">{[0,1].map(()=>negocio.clientes.map(c=><><span>{c}</span><i>✕</i></>))}</div></div><ul class="solo-lectores sr-only">{negocio.clientes.map(c=><li>{c}</li>)}</ul></section>

<section class="v2-servicios"><div class="container"><div class="section-heading" data-revela><h2>Lo que hacemos, de principio a fin</h2><a href="/como-trabajamos/">Conoce nuestro proceso <span class="flecha" aria-hidden="true">↗</span></a></div>
<div class="v2-tarjetas">{tarjetas.map(t=><a class="v2-tarjeta" href={t.href} data-servicio><img src={t.src} alt={`${t.titulo}, proyecto realizado por PZ Design`} width={t.width} height={t.height} loading="lazy" decoding="async" style={`max-width:${t.width}px`}/><span class="v2-tarjeta-texto"><span class="v2-tarjeta-titulo">{t.titulo}</span><span class="v2-tarjeta-detalle">{t.texto}</span></span><span class="v2-tarjeta-ir" aria-hidden="true" set:html={flecha}/></a>)}</div></div></section>

<section class="container section"><h2 class="solo-lectores sr-only">Dos maneras de trabajar con PZ Design</h2><div class="dos-caras" data-revela><a class="cara" href="/habilitacion-de-oficinas/"><Imagen src={P('kupfer-2').imagen} alt={alt(P('kupfer-2'))} posicion={P('kupfer-2').posicionImagen}/><span class="velo" aria-hidden="true"></span><span><span class="cara-nombre">Proyectos para empresas</span><span class="cara-texto">Habilitamos oficinas, radios y locales: diseño, obra y mobiliario con un solo responsable.</span><span class="cara-ir">Ver servicios <span class="flecha" aria-hidden="true">↗</span></span></span><span class="ir-redondo" aria-hidden="true">↗</span></a><a class="cara producto" href="/mobiliario-de-oficina/"><Imagen src="/img/catalogo/ergohuman.jpg" tipo="producto" alt="Silla Ergohuman Ultra malla del catálogo de PZ Design"/><span><span class="cara-nombre">{tienda?'Tienda de mobiliario':'Mobiliario de oficina'}</span><span class="cara-texto">{tienda?'Sillas y escritorios para tu oficina: compra en línea o pide una cotización por volumen para tu empresa.':'Sillas y escritorios para tu oficina, con asesoría y cotización según la cantidad que necesitas.'}</span><span class="cara-ir">{tienda?'Ir a la tienda':'Ver el catálogo'} <span class="flecha" aria-hidden="true">↗</span></span></span><span class="ir-redondo" aria-hidden="true">↗</span></a></div></section>

<section class="container manifiesto"><TextoRevela client:visible texto={manifiesto}/><a class="manifiesto-enlace" href="/paola-zaid/">Conoce a Paola Zaid <span class="flecha" aria-hidden="true">↗</span></a></section>

<section class="banda-noche"><div class="container section-heading galeria-cabeza" data-revela><h2>Espacios con identidad</h2><a href="/proyectos/">Ver los {proyectos.length} proyectos <span class="flecha" aria-hidden="true">↗</span></a></div><GaleriaHorizontal client:visible items={galeria}/></section>

<section class="container section cifras"><h2 class="solo-lectores sr-only">PZ Design en cifras</h2><div class="bento" data-revela><div class="b-grande"><span class="b-rotulo">Superficie del book</span><strong data-cuenta={totalM2} data-sufijo=" m²">{totalM2.toLocaleString('es-CL')} m²</strong><span>intervenidos en {conM2.length} proyectos del book con superficie documentada</span><svg class="b-cota" viewBox="0 0 100 16" preserveAspectRatio="none" aria-hidden="true"><line x1="0" y1="2" x2="0" y2="14"/><line x1="0" y1="8" x2="100" y2="8"/><line x1="100" y1="2" x2="100" y2="14"/></svg></div><div class="b-roble"><span class="b-rotulo">Küpfer</span><strong>{P('kupfer-2').resultado?.cifra}</strong><span>de dotación en el área intervenida</span></div><div class="b-papel"><span class="b-rotulo">Book 2024</span><strong data-cuenta={proyectos.length}>{proyectos.length}</strong><span>proyectos de oficinas, radios y locales</span></div><div class="b-linea"><span class="b-rotulo">{aniosExperiencia} años de experiencia</span><span>Paola Zaid diseña espacios de trabajo desde {negocio.experienciaDesde}; PZ Design es su marca desde {negocio.fundacion}</span></div></div><p class="small muted">Fuente: book PZ Design 2024.</p></section>

<section class="container section paola"><div class="paola-firma" aria-hidden="true" data-revela><span set:html={firma}/></div><div data-revela><p class="eyebrow">Diseño y ejecución</p><h2>Lo que acordamos guía lo que entregamos</h2><p>Escuchamos lo que necesita tu empresa y lo traducimos en un proyecto integrado. Coordinamos diseño, presupuesto, obra y equipamiento con equipo propio y contratistas supervisados por Paola.</p><p>Buscamos que cada decisión se refleje en una solución útil, con muebles de calidad y atención durante el proceso.</p><div class="actions"><a href="/paola-zaid/">Conoce a Paola Zaid</a></div></div></section>

<section class="banda-arena"><div class="container section"><div class="section-heading" data-revela><h2>Mobiliario para tu forma de trabajar</h2><a href="/mobiliario-de-oficina/">Explora el catálogo <span class="flecha" aria-hidden="true">↗</span></a></div><p class="text-column muted">Te ayudamos a elegir según el espacio y la cantidad que necesitas. Entregamos las sillas armadas en 3 a 7 días hábiles; el mobiliario tiene un plazo de 7 a 20 días hábiles, sujeto a la confirmación de tu cotización.</p><div class="grid" data-revela>{['tossy-negra','ergohuman','gold-up'].map(slug=>porSlug(slug)).filter(p=>p&&publicados.includes(p)).map(p=><ProductoCard producto={p}/>)}</div></div></section>
<CTA/>
</Base>
