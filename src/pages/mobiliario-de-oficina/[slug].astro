---
import Base from '../../layouts/Base.astro';import Intro from '../../components/Intro.astro';import Imagen from '../../components/Imagen.astro';import ProductoCard from '../../components/ProductoCard.astro';import {publicados,modalidadTexto,garantiaTexto} from '../../lib/catalogo';import {cotizar,absoluto} from '../../lib/negocio';import {tienda,precio,clp,VOLUMEN} from '../../lib/tienda';
export function getStaticPaths(){return publicados.map(p=>({params:{slug:p.slug},props:{p}}));}
const {p}=Astro.props;const ruta=`/mobiliario-de-oficina/${p.slug}/`;const esSilla=p.categoria.startsWith('Sillas');const esCabina=p.categoria==='Cabinas acústicas';const modalidad=modalidadTexto(p);const garantia=garantiaTexto(p);const galeria=(p.imagenes??[]).filter(x=>x!==p.imagen);
const respuesta=`${p.modelo} es parte de nuestra selección de ${p.categoria.toLowerCase()} para equipar tu oficina. ${p.descripcionTecnica[0]}${p.garantia?` Tiene una garantía de ${p.garantia} años.`:''}${modalidad?` Está disponible en ${modalidad.toLowerCase()}.`:''} Te ayudamos a revisar la configuración, la cantidad y la disponibilidad para preparar una cotización de acuerdo con lo que necesitas.`;
const description=`Cotiza ${p.modelo} para tu oficina. Revisa características, variantes${p.medidas?.length?', medidas':''} y ficha técnica en PDF, con asesoría y entrega coordinada por PZ Design.`;
const schema=[{'@type':'Product','@id':absoluto(`${ruta}#producto`),name:p.modelo,description:p.descripcionTecnica.join(' '),image:absoluto(p.imagen),category:p.categoria,url:absoluto(ruta),additionalProperty:[...(p.garantia?[{'@type':'PropertyValue',name:'Garantía',value:`${p.garantia} años`}]:[]),...(p.medidas??[]).map(m=>({'@type':'PropertyValue',name:'Medida',value:m})),...p.certificaciones.map(c=>({'@type':'PropertyValue',name:'Certificación',value:c}))]}];
const valor=tienda?precio(p.slug):undefined;
const relacionados=publicados.filter(x=>x.categoria===p.categoria&&x.slug!==p.slug).slice(0,3);
---
<Base title={`${p.modelo}: ficha y cotización | PZ Design`} description={description} migas={[{nombre:'Mobiliario de oficina',ruta:'/mobiliario-de-oficina/'},{nombre:p.modelo,ruta}]} schema={schema}>
<Intro titulo={p.modelo} respuesta={respuesta} etiqueta={p.categoria}/>
<section class="container section product-detail"><div class="split"><div><div class="product-visual"><Imagen src={p.imagen} tipo="producto" alt={`${p.modelo}, ${(p.variantes[0]??p.categoria).toLowerCase()}`}/></div>{galeria.length>0&&<div class="product-galeria">{galeria.map((src,i)=><Imagen src={src} tipo="producto" alt={`${p.modelo}, ${p.categoria.toLowerCase()}, vista ${i+2}`}/>)}</div>}<p class="small muted">Imágenes de referencia del modelo. Confirma la configuración disponible al cotizar.</p></div><div><h2>Características técnicas</h2><ul class="specs">{p.descripcionTecnica.map(x=><li>{x}</li>)}</ul>{p.variantes.length>0&&<><h2>Variantes y configuración</h2><ul>{p.variantes.map(x=><li>{x}</li>)}</ul></>}{(p.medidas?.length??0)>0&&<><h2>Medidas</h2><ul>{p.medidas!.map(x=><li>{x}</li>)}</ul></>}{modalidad&&<p><strong>Modalidad:</strong> {modalidad}</p>}{p.garantia&&<p><strong>Garantía:</strong> {p.garantia} años</p>}{p.certificaciones.length>0&&<p><strong>Certificaciones:</strong> {p.certificaciones.join(', ')}</p>}<p>{esCabina?'Coordinamos la instalación y el plazo de entrega contigo.':esSilla?'Entrega armada en 3 a 7 días hábiles.':'Entrega de mobiliario en 7 a 20 días hábiles.'} Confirmamos disponibilidad y condiciones en tu cotización.</p>{p.fichaPdf&&<p><a class="ficha-pdf" href={p.fichaPdf} download>Descargar ficha técnica (PDF)</a></p>}<div class="quote-panel" data-cotizador>{valor&&<p class="precio precio-ficha">{clp(valor)} <span class="precio-ejemplo">precio de ejemplo</span></p>}<label for="cantidad">Cantidad de unidades</label><input id="cantidad" name="cantidad" type="number" min="1" step="1" value="1" required inputmode="numeric" aria-describedby="ayuda-cantidad"/>{valor&&<button type="button" class="button" data-agregar={JSON.stringify({slug:p.slug,modelo:p.modelo,precio:valor,imagen:p.imagen})} data-cantidad-de="#cantidad">Agregar al carro</button>}<a class:list={["button",valor&&"secondary"]} data-cotizar data-modelo={p.modelo} href={cotizar(p.modelo)}>{valor?`Cotizar por volumen ↗`:"Cotizar por WhatsApp ↗"}</a>{valor&&<p class="small">¿Equipas a tu empresa? Desde {VOLUMEN} unidades te preparamos una cotización por volumen.</p>}<p id="ayuda-cantidad" class="small">Enviaremos el modelo y la cantidad seleccionada. Si no puedes cambiar la cantidad, puedes indicarla en la conversación.</p><p class="status" data-error role="status" hidden>Ingresa una cantidad entera mayor que cero.</p></div></div></div></section>
{relacionados.length>0&&<section class="container section"><h2>Otros modelos de esta categoría</h2><div class="grid" data-revela>{relacionados.map(x=><ProductoCard producto={x}/>)}</div></section>}
</Base>
<script>
import {cotizar} from '../../lib/negocio';
const panel=document.querySelector('[data-cotizador]');
const input=panel?.querySelector<HTMLInputElement>('input');
const link=panel?.querySelector<HTMLAnchorElement>('[data-cotizar]');
const error=panel?.querySelector<HTMLElement>('[data-error]');
function actualizar(){if(!input||!link||!error)return false;const n=Number(input.value);const valid=input.checkValidity()&&Number.isSafeInteger(n)&&n>0;error.hidden=valid;input.setAttribute('aria-invalid',String(!valid));if(valid)link.href=cotizar(link.dataset.modelo!,n);return valid;}
input?.addEventListener('input',actualizar);
link?.addEventListener('click',event=>{if(!actualizar()){event.preventDefault();input?.reportValidity();input?.focus();}});
</script>
