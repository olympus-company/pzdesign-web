---
import Base from '../layouts/Base.astro';import Intro from '../components/Intro.astro';import {negocio,telefonoE164,direccion,whatsapp} from '../lib/negocio';
---
<Base title="Contacto y cotizaciones para tu empresa | PZ Design" description="Cuéntanos tu proyecto de oficina, radio o local comercial. Contacta a PZ Design por WhatsApp o correo para revisar el alcance y solicitar una cotización." migas={[{nombre:'Contacto',ruta:'/contacto/'}]}>
<Intro titulo="Conversemos sobre tu proyecto" respuesta="Cuéntanos qué necesita tu empresa: renovar una oficina, habilitar un estudio, preparar un local o elegir mobiliario. Puedes escribirnos por WhatsApp o correo para revisar el espacio, la cantidad de puestos y el alcance que tienes en mente. Con esa información acordamos contigo cómo avanzar hacia una propuesta."/>
<section class="container section"><div class="split"><div><h2>Cuéntanos qué tienes en mente</h2><p>Completa estos datos para preparar tu mensaje en WhatsApp. Podrás revisarlo antes de enviarlo.</p><form class="form-grid" data-contacto action={whatsapp()} method="get"><label>¿Qué necesitas?<select name="servicio"><option>Habilitación de oficinas</option><option>Diseño y arquitectura interior</option><option>Radios y estudios</option><option>Locales comerciales</option><option>Mobiliario de oficina</option></select></label><label>Tu empresa <span class="small">Opcional</span><input name="empresa" autocomplete="organization" maxlength="120"/></label><label>Cuéntanos sobre el espacio o los muebles que necesitas<textarea name="detalle" required maxlength="1500" placeholder="Por ejemplo: queremos renovar una oficina para 120 personas en Santiago"/></label><p class="small">Usaremos esta información para responder tu consulta. Revisa nuestra <a href="/privacidad/">política de privacidad</a>.</p><button type="submit" class="button" data-enviar hidden>Preparar mensaje en WhatsApp ↗</button><noscript><p>Para enviar tu consulta, usa el enlace directo a WhatsApp o escríbenos por correo.</p></noscript></form></div><div class="contact-details"><h2>Contacto directo</h2><p>También puedes escribirnos sin completar los campos.</p><div class="actions"><a class="button" href={whatsapp()}>Abrir WhatsApp ↗</a><a class="button secondary" href={`mailto:${negocio.correo}`}>Enviar correo</a></div><dl><dt>Teléfono y WhatsApp</dt><dd><a href={`tel:${telefonoE164}`}>{negocio.telefono}</a></dd><dt>Correo</dt><dd><a href={`mailto:${negocio.correo}`}>{negocio.correo}</a></dd><dt>Dirección</dt><dd>{direccion}</dd></dl><p>Escríbenos para coordinar una visita.</p></div></div></section>
</Base>
<script>
import {whatsapp} from '../lib/negocio';
const form=document.querySelector<HTMLFormElement>('[data-contacto]');
const boton=form?.querySelector<HTMLButtonElement>('[data-enviar]');
if(form&&boton){boton.hidden=false;form.addEventListener('submit',event=>{event.preventDefault();if(!form.reportValidity())return;const data=new FormData(form);const mensaje=`Hola, quiero consultar por ${data.get('servicio')}.${data.get('empresa')?` Mi empresa: ${data.get('empresa')}.`:''}\n${data.get('detalle')}`;window.location.assign(whatsapp(mensaje));});}
</script>
