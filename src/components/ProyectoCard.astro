---
import Imagen from './Imagen.astro';
import Cota from './Cota.astro';
const {proyecto:p}=Astro.props;
---
<article class="project-card"><a href={`/proyectos/${p.slug}/`} aria-label={`Ver proyecto ${p.cliente}: ${p.nombre}`}><div class="marco" data-cota><Imagen src={p.imagen} alt={`${p.nombre} de ${p.cliente}, proyecto de ${p.tipo.toLowerCase()} realizado por PZ Design`} posicion={p.posicionImagen}/><Cota m2={p.m2}/></div></a><p class="eyebrow">{p.tipo}</p><h3 class="card-title"><a href={`/proyectos/${p.slug}/`}>{p.cliente}</a></h3><p>{p.nombre}{p.resultado && ` · ${p.resultado.cifra} ${p.resultado.descripcion}`}</p></article>
